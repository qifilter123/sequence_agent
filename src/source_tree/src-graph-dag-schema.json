{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/source-tree/src-graph-dag-schema.json",
  "title": "Source Tree DAG graph",
  "description": "A DAG graph combined with source-code symbols and agent-generated semantic annotations. CODE nodes use simple symbol names as labels. Source ownership and nesting, including class-to-attribute and class-to-method relationships, are represented by CODE contains CODE links.",
  "$comment": "Cross-node validation must enforce CODE relationships and semantic annotation relationships. Any non-semantic source node may have_intent an INTENT node or has_behavior a BEHAVIOR node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "links"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "jsonValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "null",
        "array",
        "object"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file_type",
        "source_file",
        "source_location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:code|[A-Za-z0-9_-]+)\\.[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "file_type": {
          "type": "string",
          "enum": [
            "DAG",
            "DAG_NODE",
            "OPERATION",
            "PARAM",
            "CFG_PARAM",
            "DERIVED_PARAM",
            "INPUT_LIST",
            "INPUT_MAP",
            "INPUT_FIELD",
            "OUTPUT_MAP",
            "OUTPUT_FIELD",
            "CODE",
            "INTENT",
            "BEHAVIOR"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Display name of this node. For a CODE node, this is only the symbol's simple declared name, such as HBSCAN4Config or eval_num_trx. Do not encode the parent scope as HBSCAN4Config.eval_num_trx; represent that scope with a CODE contains CODE link."
        },
        "value": {
          "$ref": "#/$defs/jsonValue"
        },
        "basis": {
          "type": "string",
          "enum": [
            "extracted",
            "inferred"
          ],
          "description": "How an INTENT or BEHAVIOR statement was obtained. Allowed only on semantic annotation nodes."
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "source_location": {
          "type": "string",
          "pattern": "^L[1-9][0-9]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "file_type": {
                "const": "PARAM"
              }
            },
            "required": [
              "file_type"
            ]
          },
          "then": {
            "required": [
              "label",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "file_type": {
                "enum": [
                  "INTENT",
                  "BEHAVIOR"
                ]
              }
            },
            "required": [
              "file_type"
            ]
          },
          "then": {
            "required": [
              "label",
              "value",
              "basis"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "file_type": {
                "not": {
                  "enum": [
                    "PARAM",
                    "INTENT",
                    "BEHAVIOR"
                  ]
                }
              }
            },
            "required": [
              "file_type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "basis"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "file_type": {
                "const": "PARAM"
              }
            },
            "required": [
              "file_type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "basis"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "file_type": {
                "enum": [
                  "DAG",
                  "DAG_NODE",
                  "OPERATION",
                  "CFG_PARAM",
                  "DERIVED_PARAM",
                  "INPUT_LIST",
                  "INPUT_MAP",
                  "OUTPUT_MAP",
                  "OUTPUT_FIELD",
                  "CODE",
                  "INTENT",
                  "BEHAVIOR"
                ]
              }
            },
            "required": [
              "file_type"
            ]
          },
          "then": {
            "required": [
              "label"
            ]
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "relation"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "description": "Graph relationship. contains represents structural ownership and may connect CODE to CODE; uses connects consumers to value providers; references connects an OPERATION to its CODE implementation; has_intent and has_behavior connect a non-semantic source node to an agent-generated semantic annotation.",
          "enum": [
            "contains",
            "uses",
            "references",
            "has_intent",
            "has_behavior"
          ]
        }
      }
    }
  }
}
